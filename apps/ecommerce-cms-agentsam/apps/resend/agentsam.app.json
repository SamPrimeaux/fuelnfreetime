{
  "schema": "agentsam.app.v1",
  "id": "resend",
  "name": "Email",
  "provider": "Resend",
  "role": "provider-app",
  "category": "communications",
  "status": "bundled",
  "routes": [
    "/admin/email"
  ],
  "provides": [
    "email.send",
    "email.batch.send",
    "email.webhook.receive",
    "email.delivery.status"
  ],
  "implementation": {
    "frontend": [
      "frontend/static/dashboard/email.html"
    ],
    "backend": [
      "backend/admin/mail.js",
      "backend/lib/mail-mailboxes.js",
      "backend/lib/resend.js",
      "backend/webhooks/resend.js"
    ]
  },
  "configuration": {
    "plugin_key": "resend",
    "credential_secret": "RESEND_API_KEY"
  },
  "navigation": {
    "placement": "apps",
    "label": "Email"
  },
  "agent": {
    "status": "plugin-and-tool-registration-pending",
    "tool_resolution": "agentsam_tools.capability_key + enabled plugin_key=resend",
    "resource_scope_source": "agentsam_plugins.resource_scope_json",
    "intended_capabilities": [
      "email.send",
      "email.batch.send",
      "email.webhook.receive",
      "email.delivery.status"
    ],
    "verified_tools": [],
    "notes": "Email/Resend runtime is implemented and working, but the live FNF agentsam_plugins registry has no resend installation and no matching Resend tools are registered yet."
  }
}
