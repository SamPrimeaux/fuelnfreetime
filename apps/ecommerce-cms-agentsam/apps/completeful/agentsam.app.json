{
  "schema": "agentsam.app.v1",
  "id": "completeful",
  "name": "Completeful",
  "role": "provider-app",
  "category": "fulfillment",
  "status": "bundled",
  "provides": [
    "commerce.catalog.read",
    "commerce.catalog.sync",
    "commerce.fulfillment.orders",
    "commerce.provider.webhooks"
  ],
  "requires": [
    "storage.sql"
  ],
  "implementation": {
    "backend": [
      "backend/admin/completeful.js",
      "backend/completeful",
      "backend/webhooks/completeful.js",
      "backend/agentsam/completeful-tools.js"
    ]
  },
  "configuration": {
    "plugin_key": "completeful",
    "credential_secret": "CAPP_KEY",
    "live_writes_gate": "COMPLETEFUL_ALLOW_LIVE_WRITES"
  },
  "extensions": [
    "product-studio"
  ],
  "agent": {
    "tool_resolution": "agentsam_tools.capability_key + enabled plugin_key=completeful",
    "resource_scope_source": "agentsam_plugins.resource_scope_json",
    "capabilities": {
      "read": [
        "catalog.read",
        "catalog.search",
        "order.quote"
      ],
      "write": [
        "catalog.sync",
        "design.create",
        "product.sync"
      ],
      "approval_required": [
        "order.create",
        "product.publish"
      ]
    },
    "notes": "These capability keys are present in the live agentsam_capabilities catalog and are backed by Completeful tools today."
  }
}
