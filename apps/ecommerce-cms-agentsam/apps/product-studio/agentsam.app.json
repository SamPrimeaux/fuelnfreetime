{
  "schema": "agentsam.app.v1",
  "id": "product-studio",
  "name": "Product Studio",
  "role": "embedded-app",
  "category": "commerce",
  "status": "bundled",
  "routes": [
    "/admin/products/create",
    "/admin/products/create/:productId",
    "/admin/products/help/artwork"
  ],
  "provides": [
    "commerce.product.draft",
    "commerce.product.studio",
    "commerce.catalog.browse"
  ],
  "requires": [
    "commerce.catalog.read"
  ],
  "optional": [
    "media.assets",
    "agentsam.mini-composer"
  ],
  "implementation": {
    "frontend": [
      "frontend/src/pages/products/ProductStudioPage.tsx",
      "frontend/src/pages/products/ArtworkHelpPage.tsx"
    ],
    "backend": [
      "backend/admin/product-studio.js"
    ]
  },
  "navigation": {
    "placement": "products"
  },
  "agent": {
    "tool_resolution": "agentsam_tools.capability_key",
    "resource_scope": "current tenant + selected commerce/media resources",
    "capabilities": {
      "read": [
        "catalog.read",
        "catalog.search"
      ],
      "write": [
        "design.create",
        "product.sync"
      ],
      "approval_required": [
        "product.publish"
      ],
      "optional_tool_capabilities": [
        "assets.media.list",
        "assets.image.variant_plan",
        "store.products.list"
      ],
      "normalization_pending": [
        "assets.media.list",
        "assets.image.variant_plan",
        "store.products.list"
      ]
    },
    "notes": "Commerce capabilities are verified in the live tool registry. Optional media/store keys currently exist on tools but are not yet normalized into agentsam_capabilities."
  }
}
