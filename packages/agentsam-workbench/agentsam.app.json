{
  "schema": "agentsam.app.v1",
  "id": "agentsam-workbench",
  "name": "AgentSam Workbench",
  "role": "embedded-package",
  "package": "@inneranimalmedia/agentsam-workbench",
  "modes": ["embedded"],
  "surfaces": [
    "mini-composer",
    "resource-inspector",
    "media-workbench"
  ],
  "provides": [
    "agentsam.composer.mount",
    "agentsam.resource.select",
    "agentsam.composer.capabilities",
    "agentsam.composer.attachments"
  ],
  "requires": [
    "agentsam.runtime.send",
    "agentsam.resource.authorize"
  ],
  "optional": [
    "agentsam.voice",
    "agentsam.generation.mount"
  ],
  "features": [
    "agentsam.mini-composer"
  ],
  "runtime": {
    "browser": "ready",
    "framework": "agnostic"
  },
  "notes": "Portable browser workbench. Hosts own resource discovery, authorization and transport; this package owns contextual selection UI, positioning, composer interaction, attachments and capability selection."
}
