# AgentSam machine state — keep contracts, ignore generated runtime state
.agentsam/*
!.agentsam/app.json
!.agentsam/README.md
!.agentsam/.gitignore

# Allow nested app/feature contracts under packages and apps
!**/.agentsam/app.json
!**/.agentsam/feature.json
!**/.agentsam/features/
!**/.agentsam/features/**
!**/.agentsam/README.md

node_modules/
.wrangler/
.dev.vars
.env.cloudflare
*.log
.DS_Store

# Local rollback snapshots; keep outside version control.
.fnf-backups/

# Generated from app/frontend by scripts/sync-app-frontend.mjs
dist/
public/admin/
