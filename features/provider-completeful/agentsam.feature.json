{
  "schema": "agentsam.feature.v1",
  "id": "provider.completeful",
  "name": "Completeful Commerce Provider",
  "kind": "provider",
  "status": "extracted",
  "package": {
    "name": "@inneranimalmedia/agentsam-provider-completeful",
    "version": "0.1.0",
    "directory": "agentsam-sdk/packages/providers/completeful"
  },
  "provides": [
    "commerce.catalog.read",
    "commerce.catalog.sync",
    "commerce.fulfillment.orders",
    "commerce.provider.webhooks"
  ],
  "requires": ["storage.sql"],
  "optional": [],
  "runtime": ["worker", "node"],
  "contributes": {
    "tools": [
      "completeful.shop.list",
      "completeful.catalog.list",
      "completeful.catalog.get",
      "completeful.order.get",
      "completeful.webhook.list"
    ],
    "webhooks": ["completeful.webhook.verify"],
    "skills": []
  },
  "secrets": {
    "server_only": ["completeful.api_key"],
    "optional": ["completeful.api_url", "completeful.allow_live_writes"]
  },
  "host_bindings": {
    "required": ["env secret map (e.g. CAPP_KEY)", "db for host catalog mirror", "admin_session"],
    "forbidden_in_feature": ["FNF_ACCOUNT_ID", "browser_exposure_of_CAPP_KEY", "account_id_hardcode"]
  },
  "source": {
    "proving_ground": "fuelnfreetime",
    "extracted_package": "agentsam-sdk/packages/providers/completeful",
    "host_mirror_paths": [
      "apps/ecommerce-cms-agentsam/backend/completeful/catalog.js",
      "apps/ecommerce-cms-agentsam/backend/completeful/images.js",
      "apps/ecommerce-cms-agentsam/backend/admin/completeful.js"
    ],
    "notes": "Provider HTTP/tools/webhooks live in the SDK package (no FNF_ACCOUNT_ID). D1 catalog mirror + admin routes remain host-owned until commerce.catalog adapter packaging."
  },
  "activation": {
    "steps": [
      "validate_manifest",
      "check_runtime",
      "resolve_requires",
      "map_host_secrets",
      "operator_approval",
      "activate",
      "verify",
      "write_install_receipt"
    ]
  }
}
